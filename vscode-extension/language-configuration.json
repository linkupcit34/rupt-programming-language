{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region",
      "end": "^\\s*#\\s*endregion"
    }
  },
  "wordPattern": "(-?\\d+\\.\\d*)|(-?\\d+)|([A-Za-z_][A-Za-z0-9_]*)|([^\\(\\)\\[\\]\\{\\},:;\\s])",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((\\w|\\d|#)+[\\s\\S]*)(:|:|:)$",
    "decreaseIndentPattern": "^\\s*((else|elif|except|finally|pass|break|continue|return|raise)[\\s\\S]*)$"
  }
}
