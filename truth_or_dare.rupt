rupt
truths = ["Какой твой самый большой страх?", "Какой постыдный факт о тебе?", "Кого ты тайно уважаешь?"]
dares = ["Спой одну строчку любой песни.", "Сделай 10 приседаний.", "Говори шёпотом 1 минуту."]

visible("Игра: Правда или Действие")
while true:
    choice = input("правда/действие (или выход): ")
    visible("[" + choice + "] len=" + str(len(choice)))
    if choice == "выход" or choice == "":
        break
    if choice == "правда":
        q = truths[randint(0, len(truths) - 1)]
        visible("Правда: " + q)
    elif choice == "действие":
        d = dares[randint(0, len(dares) - 1)]
        visible("Действие: " + d)
    else:
        visible("Напиши 'правда', 'действие' или 'выход'")
