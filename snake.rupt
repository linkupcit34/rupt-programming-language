rupt
import rupt_game

rupt_game.init()
screen = rupt_game.create_window(40, 30, "Snake")

snake = [[20, 15]]
direction = [1, 0]
food = [10, 10]
score = 0
running = true
ticks = 0

while running:
    rupt_game.fill(screen, "black")
    for seg in snake:
        rupt_game.draw_rect(screen, "green", seg[0], seg[1], 1, 1)
    rupt_game.draw_rect(screen, "red", food[0], food[1], 1, 1)
    rupt_game.flip(screen)

    head = snake[0]
    new_head = [head[0] + direction[0], head[1] + direction[1]]


    if new_head[0] < 0 or new_head[0] >= 40 or new_head[1] < 0 or new_head[1] >= 30:
        running = false

    for seg in snake:
        if seg[0] == new_head[0] and seg[1] == new_head[1]:
            running = false

    snake = [new_head] + snake
    if new_head[0] == food[0] and new_head[1] == food[1]:
        score = score + 1
        food = [ticks % 40, (ticks * 7) % 30]
    else:
        snake = snake[:len(snake) - 1]

    ticks = ticks + 1
    rupt_game.clock_tick(8)
    if ticks > 100:
        running = false

print("score:", score)
rupt_game.quit()
